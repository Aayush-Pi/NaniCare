# Point frontend to the FastAPI backend (recommended)
VITE_API_URL=http://localhost:8000

# Set to "true" only for fully offline mock scanning without FastAPI or GEMINI_API_KEY
# VITE_USE_MOCK_DATA=true

# Optional: only needed when running Express built-in preview mode (VITE_API_URL unset)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash
